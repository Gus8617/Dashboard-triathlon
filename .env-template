# .env - Fichier de configuration pour Raspberry Pi
# IMPORTANT: Ne jamais committer ce fichier dans Git!

# Port du serveur
PORT=3000

# ===== STRAVA API =====
# Obtenir ces valeurs sur: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here
STRAVA_REDIRECT_URI=http://your-raspberry-ip:3000/auth/strava/callback

# ===== GARMIN API =====
# Obtenir ces valeurs sur: https://developer.garmin.com
GARMIN_CONSUMER_KEY=your_garmin_consumer_key_here
GARMIN_CONSUMER_SECRET=your_garmin_consumer_secret_here

# ===== CONFIGURATION OPTIONNELLE =====

# Intervalle de synchronisation Strava (en heures)
STRAVA_SYNC_INTERVAL=1

# Heure de synchronisation Garmin (format: HH:MM)
GARMIN_SYNC_TIME=07:00

# Période de récupération des données (en jours)
DATA_FETCH_DAYS=90

# Activer les logs détaillés
DEBUG_MODE=false